      "name": "4. Lease Creation & Signing",
      "item": [
        {
          "name": "4.1 Owner - Create Lease Draft",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "applicationId",
                  "value": "INSERT_APPLICATION_ID_HERE",
                  "type": "text"
                },
                {
                  "key": "startDate",
                  "value": "2026-07-01T00:00:00Z",
                  "type": "text"
                },
                {
                  "key": "endDate",
                  "value": "2027-07-01T00:00:00Z",
                  "type": "text"
                },
                {
                  "key": "monthlyRent",
                  "value": "35000",
                  "type": "text"
                },
                {
                  "key": "securityDeposit",
                  "value": "100000",
                  "type": "text"
                },
                {
                  "key": "paymentFrequency",
                  "value": "Monthly",
                  "type": "text"
                },
                {
                  "key": "noticePeriodDays",
                  "value": "30",
                  "type": "text"
                },
                {
                  "key": "penaltyPercentage",
                  "value": "5.0",
                  "type": "text"
                },
                {
                  "key": "agreementText",
                  "value": "Lease Agreement details and standard terms.",
                  "type": "text"
                },
                {
                  "key": "unsignedAgreement",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/Leases",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "Leases"
              ]
            },
            "description": "Owner drafts lease for approved application."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data) {",
                  "    var data = jsonData.data;",
                  "    if (data.propertyId) pm.collectionVariables.set('propertyId', data.propertyId);",
                  "    if (data.applicationId) pm.collectionVariables.set('applicationId', data.applicationId);",
                  "    if (data.leaseId) pm.collectionVariables.set('leaseId', data.leaseId);",
                  "    if (data.requestId) pm.collectionVariables.set('requestId', data.requestId);",
                  "    if (data.complaintId) pm.collectionVariables.set('complaintId', data.complaintId);",
                  "    if (data.accessToken) {",
                  "        var reqName = pm.info.requestName.toLowerCase();",
                  "        if (reqName.includes('tenant')) {",
                  "             pm.collectionVariables.set('tenantToken', data.accessToken);",
                  "        } else if (reqName.includes('admin')) {",
                  "             pm.collectionVariables.set('adminToken', data.accessToken);",
                  "        } else {",
                  "             pm.collectionVariables.set('ownerToken', data.accessToken);",
                  "        }",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
