{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=realestate_db;Username=postgres;Password=Arvind"
  },
  "Jwt": {
    "Issuer": "EstateSyncApi",
    "Audience": "EstateSyncClient",
    "ExpiryMinutes": "1440",
    "SecretKey": "SuperSecretKeyForEstateSyncApp12345678901234567890!"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }},
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/MyAppLog-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "EstateSyncApi"
    }
  },
  "Stripe": {
    "SecretKey": "sk_test_... (removed for security)",
    "PublishableKey": "pk_test_... (removed for security)",
    "WebhookSecret": "whsec_... (removed for security)"
  }
}
