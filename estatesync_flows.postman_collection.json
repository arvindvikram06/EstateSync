{
  "info": {
    "name": "EstateSync Flow",
    "description": "This collection contains the ordered step-by-step user journeys and workflows for EstateSync. URL path parameters use standard Postman variables (:id) for easy input.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Setup & Initialization",
      "item": [
        {
          "name": "Reset and Seed Database",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/System/reset-and-seed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "System", "reset-and-seed"]
            },
            "description": "Resets all transactional tables and seeds default user roles, locations, and demo users."
          }
        }
      ]
    },
    {
      "name": "1. Landlord Onboarding Flow",
      "item": [
        {
          "name": "1.1 Landlord - Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Bob New Landlord\",\n  \"email\": \"owner.new@estatesync.com\",\n  \"phoneNumber\": \"3456789012\",\n  \"password\": \"Password123!\",\n  \"role\": \"Owner\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/Auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Auth", "register"]
            },
            "description": "Registers a new user with the Landlord/Owner role."
          }
        },
        {
          "name": "1.2 Landlord - Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set(\"ownerToken\", jsonData.data.accessToken);",
                  "}"
                ],
                "type": "javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner.new@estatesync.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/Auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Auth", "login"]
            },
            "description": "Authenticates the landlord and saves the token to ownerToken."
          }
        },
        {
          "name": "1.3 Landlord - Initiate Verification Draft",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Owners/me/verification-request/draft",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Owners", "me", "verification-request", "draft"]
            },
            "description": "Creates a draft Landlord Verification Request."
          }
        },
        {
          "name": "1.4 Landlord - Upload Verification Document",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "documentType",
                  "value": "PAN",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/Owners/me/verification-request/:requestId/documents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Owners", "me", "verification-request", ":requestId", "documents"],
              "variable": [
                {
                  "key": "requestId",
                  "value": ""
                }
              ]
            },
            "description": "Uploads the PAN document for verification."
          }
        },
        {
          "name": "1.5 Landlord - Submit Verification Request",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"panOrTaxId\": \"ABCDE1234F\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/Owners/me/verification-request/:requestId/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Owners", "me", "verification-request", ":requestId", "submit"],
              "variable": [
                {
                  "key": "requestId",
                  "value": ""
                }
              ]
            },
            "description": "Submits the landlord verification request for admin review."
          }
        },
        {
          "name": "1.6 Landlord - Create Stripe Connected Account",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Payments/owner-onboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Payments", "owner-onboard"]
            },
            "description": "Returns a Stripe connected onboarding link for the landlord to set up payouts."
          }
        }
      ]
    },
    {
