{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Email": {
    "Enabled": false,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromName": "EstateSync",
    "FromAddress": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=realestate_db;Username=postgres;Password=YOUR_POSTGRES_PASSWORD",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Jwt": {
    "Issuer": "EstateSyncApi",
    "Audience": "EstateSyncClient",
    "ExpiryMinutes": "15",
    "SecretKey": "YOUR_JWT_SECRET_MIN_32_CHARS_REPLACE_THIS_NOW!!"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }},
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/MyAppLog-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "EstateSyncApi"
    }
  },
  "AiService": {
    "BaseUrl": "http://ai-service:8000"
  },
  "Stripe": {
    "SecretKey": "YOUR_STRIPE_SECRET_KEY",
    "PublishableKey": "YOUR_STRIPE_PUBLISHABLE_KEY",
    "WebhookSecret": "YOUR_STRIPE_WEBHOOK_SECRET",
    "ConnectedAccountWebhookSecret": "",
    "OnboardingRefreshUrl": "http://localhost:4200/payments/success?type=onboarding",
    "OnboardingReturnUrl": "http://localhost:4200/payments/success?type=onboarding",
    "CheckoutSuccessUrl": "http://localhost:4200/payments/success?type=rent",
    "CheckoutCancelUrl": "http://localhost:4200/payments/cancel",
    "PlatformFeePercent": "0.02",
    "StripeFeePercent": "0.054",
    "StripeFeeFixedInr": "25.0"
  }
}
